DATABASE_URL=sqlite+aiosqlite:///./btvn_ktpm.db
ORDER_DATABASE_URL=sqlite+aiosqlite:///./orders.db
SECRET_KEY=replace-with-a-private-random-secret
GATEWAY_SECRET=replace-with-a-different-private-random-secret
ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
USER_SERVICE_URL=http://127.0.0.1:8001
ORDER_SERVICE_URL=http://127.0.0.1:8002
UPSTREAM_TIMEOUT_SECONDS=10

# Internal SDK endpoint and the address reachable by the uploader.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=avatars
MINIO_REGION=us-east-1
